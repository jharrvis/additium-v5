<?php
/**
 * ADDITIUM 3D – Local Environment Configuration
 * -----------------------------------------------
 * Copy this file to api/.env.php and fill in your values.
 * This file is committed as a template. api/.env.php is gitignored.
 *
 * These values are only used when running locally (Laragon/Apache).
 * For Vercel, set the same variables in:
 * Vercel Dashboard → Project Settings → Environment Variables
 */

// Required: Resend API key (get from https://resend.com/api-keys)
putenv('RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx');

// Required for email notifications: main recipient email
putenv('NOTIFY_EMAIL=your-email@example.com');

// Required for cron security: random secret string
// Must match CRON_SECRET in Vercel environment variables
putenv('CRON_SECRET=your-random-secret-here');
